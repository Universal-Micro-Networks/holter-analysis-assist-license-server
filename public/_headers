# Workers Static Assets answers these files before the Worker runs, so the console's response hook cannot add
# security headers to them. CSP here only governs files opened directly (for example favicon.svg).
/console/assets/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
