{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holter-analysis-assist-license-server",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holter-analysis-assist-license",
      // Replace with the id printed by `uv run pywrangler d1 create holter-analysis-assist-license` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Must be unique within the Cloudflare account.
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Serve only from a custom domain (add "routes" with "custom_domain": true) with "Always Use HTTPS" enabled on the zone.
  "workers_dev": false,
  "preview_urls": false
}
